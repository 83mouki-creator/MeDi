{
  "name": "medi",
  "version": "1.0.0",
  "private": true,
  "description": "MeDi — plateforme e-commerce quincaillerie, industrie, bâtiment et équipement domestique à Daloa (Côte d'Ivoire)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:local": "tsx --env-file-if-exists=.env.local scripts/local-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:migrate:dev": "drizzle-kit generate && tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "import:photos": "tsx --env-file-if-exists=.env.local scripts/import-photos.ts",
    "import:catalog": "tsx --env-file-if-exists=.env.local scripts/import-catalog.ts",
    "reindex:visual": "tsx --env-file-if-exists=.env.local scripts/reindex-visual.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "tsx --env-file-if-exists=.env.local scripts/test-db-setup.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset-db.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.1",
    "dotenv": "17.2.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
