# ─────────────── Base de données (Neon) ───────────────
# Connexion POOLÉE (hostname contenant « -pooler ») : utilisée par l'application.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/medi?sslmode=require"
# Connexion DIRECTE : migrations, scripts d'import, sauvegardes.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/medi?sslmode=require"

# ─────────────── Application ───────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─────────────── Paiement Wave (https://docs.wave.com/checkout) ───────────────
# Clé API Wave Business (Côte d'Ivoire). Laissez vide pour utiliser le mode manuel.
WAVE_API_KEY=""
# Secret de signature des requêtes (optionnel, si activé sur la clé API).
WAVE_SIGNING_SECRET=""
# Secret fourni par Wave lors de l'enregistrement du webhook.
WAVE_WEBHOOK_SECRET=""
# Numéro Wave marchand affiché au client en mode manuel (ex. +225...).
WAVE_MERCHANT_NUMBER=""
# MANUAL = vérification par l'administrateur ; AUTO = webhooks + vérification API.
WAVE_MODE="MANUAL"
WAVE_API_BASE="https://api.wave.com"

# ─────────────── Stockage des images ───────────────
# local | cloudinary
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="public/uploads"
STORAGE_PUBLIC_BASE="/uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="medi/products"

# ─────────────── Recherche visuelle ───────────────
# local = descripteur perceptif intégré (aucune clé requise)
# http  = modèle de vision externe compatible OpenAI (embeddings)
# none  = fonctionnalité désactivée proprement
VISION_PROVIDER="local"
VISION_API_URL=""
VISION_API_KEY=""
VISION_MODEL="clip-vit-base-patch32"
VISION_DIM=""

# ─────────────── Divers ───────────────
# Limite de taille des téléversements (octets) — 5 Mo par défaut
UPLOAD_MAX_BYTES="5242880"
DATABASE_POOL_MAX="10"

# ─────────────── Tâche planifiée (Vercel Cron) ───────────────
# Jeton attendu dans l'en-tête Authorization: Bearer … de /api/cron/expire-reservations.
# Sans valeur, la route refuse toutes les requêtes (503).
CRON_SECRET=""

# ─────────────── Base de test (suite Vitest) ───────────────
# Base séparée : les tests TRUNCATE leurs tables, jamais celles de la boutique.
TEST_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/medi_test?sslmode=require"

# ─────────────── Compte administrateur initial (usage ponctuel) ───────────────
# Utilisé uniquement par `npm run admin:create`, jamais lu par l'application.
MEDI_ADMIN_EMAIL=""
MEDI_ADMIN_PASSWORD=""
MEDI_ADMIN_ROLE="OWNER"
MEDI_ADMIN_NAME=""
