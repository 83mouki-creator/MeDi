# ─────────────── Base de données (Neon) ───────────────
# Connexion POOLÉE (hostname contenant « -pooler ») : utilisée par l'application.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/perokado?sslmode=require"
# Connexion DIRECTE : migrations, scripts d'import, sauvegardes.
# Optionnelle si la base vient de l'intégration Neon sur Vercel : le code utilise
# alors DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING, ou à défaut retire le
# suffixe « -pooler » de l'hôte de DATABASE_URL.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/perokado?sslmode=require"

# ─────────────── Application ───────────────
# URL publique du site : liens des e-mails, retour de paiement, partage.
# En production : https://perokado.vercel.app (ou le domaine propre s'il est ajouté).
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Jeton d'activation du premier compte propriétaire (/activation?token=…).
# Laisser VIDE : l'activation est alors désactivée. Utilisé une seule fois,
# puis à supprimer une fois le compte administrateur créé.
ADMIN_SETUP_TOKEN=""

# ─────────────── Paiement Wave (https://docs.wave.com/checkout) ───────────────
# Clé API Wave Business (Côte d'Ivoire). Laissez vide pour utiliser le mode manuel.
WAVE_API_KEY=""
# Secret de signature des requêtes (optionnel, si activé sur la clé API).
WAVE_SIGNING_SECRET=""
# Secret fourni par Wave lors de l'enregistrement du webhook.
WAVE_WEBHOOK_SECRET=""
# Numéro Wave marchand affiché au client en mode manuel (ex. +225...).
WAVE_MERCHANT_NUMBER=""
# MANUAL = vérification par l'administrateur ; AUTO = webhooks + vérification API.
WAVE_MODE="MANUAL"
WAVE_API_BASE="https://api.wave.com"

# ─────────────── Stockage des images ───────────────
# local | cloudinary
# En production sans Cloudinary, les photos sont conservées dans la base
# (table `stored_images`) et servies par /media/<id> : elles ne disparaissent
# pas au déploiement. Rien d'autre à configurer.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="public/uploads"
STORAGE_PUBLIC_BASE="/uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="perokado/products"

# ─────────────── Recherche visuelle ───────────────
# local = descripteur perceptif intégré (aucune clé requise)
# http  = modèle de vision externe compatible OpenAI (embeddings)
# none  = fonctionnalité désactivée proprement
VISION_PROVIDER="local"
VISION_API_URL=""
VISION_API_KEY=""
VISION_MODEL="clip-vit-base-patch32"
VISION_DIM=""

# ─────────────── Divers ───────────────
# Limite de taille des téléversements (octets) — 5 Mo par défaut
UPLOAD_MAX_BYTES="5242880"
DATABASE_POOL_MAX="10"

# ─────────────── Tâche planifiée (Vercel Cron) ───────────────
# Jeton attendu dans l'en-tête Authorization: Bearer … de /api/cron/expire-reservations.
# Sans valeur, la route refuse toutes les requêtes (503).
CRON_SECRET=""

# ─────────────── Base de test (suite Vitest) ───────────────
# Base séparée : les tests TRUNCATE leurs tables, jamais celles de la boutique.
TEST_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/perokado_test?sslmode=require"

# ─────────────── Compte administrateur initial (usage ponctuel) ───────────────
# Utilisé uniquement par `npm run admin:create`, jamais lu par l'application.
PEROKADO_ADMIN_EMAIL=""
PEROKADO_ADMIN_PASSWORD=""
PEROKADO_ADMIN_ROLE="OWNER"
PEROKADO_ADMIN_NAME=""

# ─────────────── E-mails transactionnels (voir docs/EMAIL.md) ───────────────
# Fournisseur retenu : Brevo (300 e-mails/jour gratuits). Resend reste possible.
# Sans clé + expéditeur, aucun e-mail n'est envoyé : les liens de réinitialisation
# restent remis par WhatsApp depuis /admin/utilisateurs.
BREVO_API_KEY=""
RESEND_API_KEY=""
# Doit être une adresse du domaine authentifié chez le fournisseur.
EMAIL_FROM="Perokado <no-reply@perokado.com>"
# Adresse de réponse : les réponses du client arrivent à la boutique.
EMAIL_REPLY_TO="contact@perokado.com"

# ─────────────── Transports : Colis Express (expéditions hors Daloa) ───────────────
# Le suivi client fonctionne SANS configuration : le code de suivi (CLI-XXXXXX)
# saisi dans /admin/expeditions ouvre la page publique du prestataire.
COLIS_EXPRESS_TRACKING_BASE="https://colisexpress-shopin30.vercel.app"
# Facultatif : lecture automatique du statut des colis. Laisser vide si le
# prestataire ne fournit pas d'API — l'administration proposera alors le lien de
# suivi et la mise à jour manuelle, sans rien simuler.
COLIS_EXPRESS_API_BASE=""
COLIS_EXPRESS_TOKEN=""
# Chemin de lecture d'un colis ({code} remplacé par le code de suivi).
COLIS_EXPRESS_STATUS_PATH="/api/colis/{code}"
COLIS_EXPRESS_TIMEOUT_MS="6000"
